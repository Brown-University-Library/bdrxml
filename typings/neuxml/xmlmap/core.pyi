"""Describe XML object construction and the types returned by parsing helpers."""

from collections.abc import Mapping, Sequence
from os import PathLike
from typing import BinaryIO, ClassVar, overload

from lxml.etree import XSLT, Resolver, XMLSchema, _Element, _ElementTree

class XmlObject:
    node: _Element
    ROOT_NAME: ClassVar[str | None]
    ROOT_NS: ClassVar[str | None]
    ROOT_NAMESPACES: ClassVar[dict[str, str]]
    XSD_SCHEMA: ClassVar[str | None]
    schema_validate: ClassVar[bool]
    def __init__(self, node: _Element | None = None, context: Mapping[str, object] | None = None, **kwargs: object) -> None: ...
    def serialize(self, stream: None = None, pretty: bool = False) -> bytes: ...
    def serializeDocument(self, stream: None = None, pretty: bool = False) -> bytes: ...
    def is_valid(self) -> bool: ...
    def is_empty(self) -> bool: ...
    def validation_errors(self) -> Sequence[object]: ...

@overload
def load_xmlobject_from_string[T: XmlObject](string: str | bytes, xmlclass: type[T], validate: bool = False, resolver: Resolver | None = None) -> T: ...
@overload
def load_xmlobject_from_string(string: str | bytes, *, validate: bool = False, resolver: Resolver | None = None) -> XmlObject: ...
@overload
def load_xmlobject_from_file[T: XmlObject](filename: str | PathLike[str] | BinaryIO, xmlclass: type[T], validate: bool = False, resolver: Resolver | None = None) -> T: ...
@overload
def load_xmlobject_from_file(filename: str | PathLike[str] | BinaryIO, *, validate: bool = False, resolver: Resolver | None = None) -> XmlObject: ...
def loadSchema(uri: str, base_uri: str | None = None) -> XMLSchema: ...
def parseString(string: str | bytes, uri: str | None = None) -> _Element: ...
def parseUri(stream: str | BinaryIO) -> _ElementTree: ...
def load_xslt(filename: str | None = None, xsl: str | None = None) -> XSLT: ...

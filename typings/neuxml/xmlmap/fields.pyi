"""Describe the instance values installed by neuxml's XML field metaclass."""

from collections.abc import MutableSequence, Sequence
from datetime import date, datetime
from typing import Self, overload

from neuxml.xmlmap.core import XmlObject

class Field[T]:
    def __init__(self, xpath: str, *args: object, **kwargs: object) -> None: ...
    @overload
    def __get__(self, instance: None, owner: type | None = None) -> Self: ...
    @overload
    def __get__(self, instance: object, owner: type | None = None) -> T: ...
    def __set__(self, instance: object, value: T) -> None: ...

class StringField(Field[str | None]):
    def __init__(self, xpath: str, normalize: bool = False, choices: Sequence[str] | None = None, **kwargs: object) -> None: ...

class StringListField(Field[MutableSequence[str]]): ...
class IntegerField(Field[int | None]): ...
class IntegerListField(Field[MutableSequence[int]]): ...
class FloatField(Field[float | None]): ...
class FloatListField(Field[MutableSequence[float]]): ...
class SimpleBooleanField(Field[bool | None]): ...
class DateTimeField(Field[datetime | None]): ...
class DateTimeListField(Field[MutableSequence[datetime]]): ...
class DateField(Field[date | None]): ...
class DateListField(Field[MutableSequence[date]]): ...
class ItemField(Field[object]): ...
class SchemaField(StringField):
    def __init__(self, xpath: str, schema_type: str, **kwargs: object) -> None: ...

class NodeField[T: XmlObject](Field[T | None]):
    def __init__(self, xpath: str, node_class: type[T], instantiate_on_get: bool = False, **kwargs: object) -> None: ...
    def __set__(self, instance: object, value: XmlObject | None) -> None: ...

class NodeListField[T](Field[MutableSequence[T]]):
    def __init__(self, xpath: str, node_class: type[T], **kwargs: object) -> None: ...
